+static int em_inherited_clock(struct em_host *h)
+{
+	u32 pll, control, output, ckgen;
+	int ret;
+
+	ret = regmap_read(h->crt, CRT_PLL_EMMC3, &pll);
+	if (ret)
+		return ret;
+	ret = regmap_read(h->crt, CRT_PLL_EMMC1, &control);
+	if (ret)
+		return ret;
+	ret = regmap_read(h->crt, CRT_PLL_EMMC4, &output);
+	if (ret)
+		return ret;
+	ckgen = em_read(h, EM_CKGEN_CTL);
+	/* These are the vendor BSP's rates with the wrapper divider bypassed.
+	 * Modern SPI leaves the FSBL's 80 MHz clock; vendor U-Boot used 200 MHz.
+	 * Keep the PLL, pad voltage and phases untouched, and derive CLKDIV from
+	 * the verified input rate rather than assuming an HS200 handoff.
+	 */
+	if ((pll & 0xffff) != 0x4388 || !(control & PLL_RSTB) ||
+	    !(output & BIT(0)) || ckgen != 0x2100)
+		goto unverified;
+	switch (pll >> 16) {
+	case EM_PLL_80MHZ:
+		h->bus_hz = 80000000;
+		break;
+	case EM_PLL_100MHZ:
+		h->bus_hz = 100000000;
+		break;
+	case EM_PLL_200MHZ:
+		h->bus_hz = 200000000;
+		break;
+	default:
+		goto unverified;
+	}
+	dev_info(h->dev, "inherited eMMC clock %lu MHz (PLL %08x)\n",
+		 h->bus_hz / 1000000, pll);
+	return 0;
+
+unverified:
+	return dev_err_probe(h->dev, -EINVAL,
+		"Unverified inherited eMMC clock: PLL %08x control %08x output %08x CKGEN %08x\n",
+		pll, control, output, ckgen);
+}
