// Pinned Armbian 0034/0040/0047/0051/0054/0059, isolated activation profiles.
// RTD1395 ISO interrupt mux source 2 is UART0 (pinned Armbian 0030).
&uart0 { interrupts-extended = <&iso_irq_mux 2>; };
#include <dt-bindings/gpio/gpio.h>
/ {
    model = "Banana Pi BPI-M4 Fedora peripheral test";
    usb_p2_vbus: regulator-usb-p2-vbus {
        compatible = "regulator-fixed";
        regulator-name = "usb_p2_vbus";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        gpio = <&iso_gpio 49 GPIO_ACTIVE_LOW>;
        regulator-always-on;
        status = "okay";
    };
    chosen {
        #address-cells = <1>; #size-cells = <1>; ranges;
        framebuffer@14200000 {
            compatible = "simple-framebuffer";
            reg = <0x14200000 0x007e9000>;
            width = <1920>; height = <1080>; stride = <7680>;
            format = "x8b8g8r8";
            status = "disabled";
        };
    };
};
&rpc_comm { no-map; };
&rpc_ringbuf { no-map; };
&crt {
    crt_clk: clock-controller@c {
        compatible = "realtek,rtd1295-crt-clk";
        reg = <0xc 0x8>; #clock-cells = <1>;
        status = "okay";
    };
};
&iso {
    iso_irq_mux: interrupt-controller@0 {
        compatible = "realtek,rtd1395-iso-irq-mux";
        reg = <0x0 0x4>, <0x40 0x4>;
        interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
        interrupt-controller; #interrupt-cells = <1>; #address-cells = <0>;
        status = "okay";
    };
    iso_clk: clock-controller@8c {
        compatible = "realtek,rtd1295-iso-clk";
        reg = <0x8c 0x4>; #clock-cells = <1>;
        status = "okay";
    };
    iso_gpio: gpio@100 {
        compatible = "realtek,rtd1395-iso-gpio";
        reg = <0x100 0x100>, <0x0 0xe8>;
        bananapi,shared-iso-irq-window;
        interrupt-parent = <&iso_irq_mux>;
        interrupts = <19>, <20>;
        gpio-controller; #gpio-cells = <2>;
        status = "okay";
    };
};
&rbus {
    emmc: mmc@12000 {
        compatible = "bananapi,bpi-m4-emmc-test", "realtek,rtd1395-emmc";
        reg = <0x12000 0x600>;
        interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&crt_clk 24>, <&crt_clk 28>;
        clock-names = "biu", "ip";
        realtek,sb2 = <&sb2>; realtek,crt = <&crt>;
        bus-width = <1>; max-frequency = <20000000>; non-removable;
        status = "okay";
    };
    usb_u2host_usb2phy: usb-phy@13c14 {
        compatible = "realtek,rtd1395-usb2phy-2port";
        reg = <0x13c14 0x4>, <0x31280 0x8>; #phy-cells = <0>;
        status = "okay";
    };
    usb@13c00 {
        compatible = "realtek,rtd1395-dwc3", "realtek,rtd-dwc3";
        reg = <0x13c00 0x140>, <0x13d60 0x4>;
        #address-cells = <1>; #size-cells = <1>; ranges;
        status = "okay";
        usb@29000 {
            compatible = "snps,dwc3";
            reg = <0x29000 0x9000>;
            interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
            clocks = <&iso_clk 16>, <&iso_clk 14>, <&iso_clk 15>;
            clock-names = "bus_early", "ref", "suspend";
            resets = <&iso_reset 14>, <&iso_reset 15>, <&iso_reset 16>,
                     <&iso_reset 17>, <&iso_reset 18>, <&iso_reset 19>, <&iso_reset 20>;
            phys = <&usb_u2host_usb2phy>; phy-names = "usb2-phy";
            dr_mode = "host"; maximum-speed = "high-speed";
            snps,dis_u2_susphy_quirk;
        };
    };
    acpu: audio-cpu@1a104 {
        compatible = "realtek,rtd1395-acpu", "realtek,rtd1295-acpu";
        reg = <0x1a104 0xc>;
        interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
        memory-region = <&rpc_comm>, <&rpc_ringbuf>, <&fc_audio_heap>, <&fc_media_heap>, <&fc_audio_fw>;
        memory-region-names = "comm", "ring", "audio", "media", "firmware";
        realtek,hdmi-audio-out;
        status = "disabled";
    };
};
