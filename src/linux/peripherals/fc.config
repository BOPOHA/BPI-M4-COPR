CONFIG_LOCALVERSION="-bpi-m4-fc-p10"
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_RTD129X_CRT=y
CONFIG_REALTEK_RTD129X_IRQ_MUX=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_RTD=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_RTD129X_EMMC=m
# CONFIG_BPI_M4_EMMC_AUDIT is not set
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_RTK=y
CONFIG_PHY_RTK_RTD_USB2PHY=y
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RTW88=m
CONFIG_RTW88_8821CU=m
CONFIG_RFKILL=y
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_RTD129X_ACPU=m
CONFIG_SND_RTD129X_HDMI_OUT=m
# CONFIG_SND_RTD129X_HDMIRX is not set
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DP_AUX_CHARDEV=y
CONFIG_RTD129X_VO=m
# CONFIG_DRM_FBDEV_EMULATION is not set

CONFIG_RTD119X_WATCHDOG=y
CONFIG_I2C_CHARDEV=m
CONFIG_SND_USB_AUDIO=m
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_CRYPTO_SHA256=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=m
