+
+/* Explicit Linux startup: validate before launching the independent ACPU.
+ * Adapted from RTD1395 BSP do_go_audio_fw()/set_one_step_info and Armbian
+ * ring_init/acpu_start. No automatic activation until hardware qualification.
+ */
+static int acpu_start_fresh(struct rtd_acpu *acpu)
+{
+ static const u8 expected[32] = {
+  0x77,0x48,0x32,0xda,0x0a,0x18,0xc1,0xba,0x83,0x7f,0xf4,0x19,0x26,0x50,0x2f,0xb8,
+  0x44,0x4e,0x83,0x39,0x75,0x62,0xc7,0x17,0x0c,0x71,0x43,0x54,0x16,0xaf,0xf4,0xdf
+ };
+ struct device_node *chosen;
+ const char *mode;
+ bool secure_armed;
+ unsigned int clock_state;
+ const struct firmware *fw;
+ struct crypto_shash *tfm;
+ struct shash_desc *desc;
+ struct regmap *crt;
+ void __iomem *startup = NULL;
+ u8 digest[32];
+ int i, ret;
+
+ chosen = of_find_node_by_path("/chosen");
+ if (!chosen) return -ENODEV;
+ ret = of_property_read_string(chosen, "bananapi,media-startup", &mode);
+ if (!ret && strcmp(mode, "explicit-linux-test") &&
+     strcmp(mode, "secure-armed-linux-test")) ret = -EINVAL;
+ of_node_put(chosen);
+ if (ret) return dev_err_probe(acpu->dev, ret, "Explicit Linux media startup marker absent\n");
+ secure_armed = !strcmp(mode, "secure-armed-linux-test");
+ if (acpu->kseg || (readl(acpu->sb2 + RPC_INT_EN) & RPC_INT_SA))
+  return dev_err_probe(acpu->dev, -EBUSY, "ACPU RPC already active; require physical cold boot\n");
+ crt = syscon_regmap_lookup_by_phandle(acpu->dev->of_node, "realtek,crt");
+ if (IS_ERR(crt)) return PTR_ERR(crt);
+ ret = regmap_read(crt, 0x10, &clock_state);
+ if (ret) return ret;
+ if (clock_state & BIT(4))
+  return dev_err_probe(acpu->dev, -EBUSY, "ACPU clock already enabled; require physical cold boot\n");
+ if (!secure_armed) {
+  startup = devm_ioremap(acpu->dev, 0x98081340, sizeof(u32));
+  if (!startup) return -ENOMEM;
+  if (readl(startup) == 0xdeaddead)
+   return dev_err_probe(acpu->dev, -EACCES, "Secure startup flag inaccessible; use checked EL3 armed handoff\n");
+ }
+ ret = request_firmware(&fw, "realtek/rtd1395/bluecore.audio", acpu->dev);
+ if (ret) return ret;
+ if (fw->size != 4319769 || fw->size > acpu->fw_size) { ret = -EINVAL; goto release; }
+ tfm = crypto_alloc_shash("sha256", 0, 0);
+ if (IS_ERR(tfm)) { ret = PTR_ERR(tfm); goto release; }
+ desc = kzalloc(sizeof(*desc) + crypto_shash_descsize(tfm), GFP_KERNEL);
+ if (!desc) { crypto_free_shash(tfm); ret = -ENOMEM; goto release; }
+ desc->tfm = tfm;
+ ret = crypto_shash_digest(desc, fw->data, fw->size, digest);
+ kfree(desc); crypto_free_shash(tfm);
+ if (ret || memcmp(digest, expected, sizeof(expected))) { ret = -EBADMSG; goto release; }
+ /* IRQ and allocation pools exist, but firmware is not released yet. */
+ memset_io(acpu->fw, 0, acpu->fw_size);
+ memcpy_toio(acpu->fw, fw->data, fw->size);
+ memset_io(acpu->comm, 0, 0x1000);
+ memset_io(acpu->ring, 0, acpu->ring_size);
+ writel(cpu_to_be32(0x16803001), acpu->comm);
+ writel(cpu_to_be32(0x2f000), acpu->comm + 4);
+ writel(cpu_to_be32(0xd8007800), acpu->comm + 0xc4);
+ writel(cpu_to_be32(0x2f800), acpu->comm + 0xc8);
+ writel(cpu_to_be32(0x2f600), acpu->comm + 0xcc);
+ writel(cpu_to_be32(0x8f900000), acpu->comm + 0xe0);
+ writel(cpu_to_be32(0x2f900), acpu->comm + 0xe4);
+ /* MIPS one-step TV record, fixed RGB 8-bit 1080p60. */
+ /* Leave the vendor one-step record invalid: the tested firmware default
+  * avoids its early one-step mixer/HDMI exception. Other fields stay unchanged.
+  */
+ writel(0, acpu->comm + 0x800);
+ writel(cpu_to_be32(2), acpu->comm + 0x804);
+ writel(cpu_to_be32(25), acpu->comm + 0x808);
+ writeb(1, acpu->comm + 0x80c); writeb(1, acpu->comm + 0x80d);
+ writel(cpu_to_be32(1), acpu->comm + 0x810);
+ writel(cpu_to_be32(4), acpu->comm + 0x814);
+ writel(cpu_to_be32(1), acpu->comm + 0x81c);
+ writel(cpu_to_be32(3), acpu->comm + 0x820);
+ writeb(1, acpu->comm + 0x824); writeb(0x28, acpu->comm + 0x826);
+ writeb(16, acpu->comm + 0x828);
+ writel(cpu_to_be32(2), acpu->comm + 0x838);
+ for (i = 0; i < NR_RINGS; i++) {
+  u32 recs[] = { POLL_REC(i), INTR_REC(i), KERN_REC(i) };
+  u32 bufs[] = { POLL_RING(i), INTR_RING(i), KERN_RING(i) };
+  int j;
+  for (j = 0; j < ARRAY_SIZE(recs); j++) {
+   u32 buf = acpu->ring_acpu + bufs[j];
+   writel(buf, acpu->ring + recs[j] + REC_BUF);
+   writel(buf, acpu->ring + recs[j] + REC_START);
+   writel(buf + RING_SIZE, acpu->ring + recs[j] + REC_END);
+   writel(buf, acpu->ring + recs[j] + REC_IN);
+   writel(buf, acpu->ring + recs[j] + REC_OUT);
+  }
+ }
+ wmb();
+ dev_info(acpu->dev, "verified firmware loaded; IRQ/rings prepared; one-step boot display deferred\n");
+ if (!secure_armed) {
+  writel(0xacd1, startup); /* RTD1395 BSP startup flag, not RTD161x. */
+  wmb();
+  if (readl(startup) != 0xacd1) { ret = -EACCES; goto release; }
+ }
+ ret = regmap_read(crt, 0x10, &clock_state);
+ if (ret || (clock_state & BIT(4))) { ret = ret ?: -EBUSY; goto release; }
+ dev_info(acpu->dev, "releasing ACPU clock after verified secure handoff and Linux preparation\n");
+ /* Independent firmware cannot be unloaded or reclaimed until cold boot. */
+ __module_get(THIS_MODULE);
+ acpu->fw_launch_attempted = true;
+ ret = regmap_update_bits(crt, 0x10, BIT(4), BIT(4));
+ if (ret) goto release;
+ /* Allow early audio firmware initialization before releasing its RPC wait.
+  * This is a bounded diagnostic delay, not proof of firmware readiness.
+  */
+ msleep(1000);
+ writel(SYNC_RPC_NOTIFY, acpu->comm + IPC_VO_INT_SYNC);
+ acpu_kick(acpu);
+ wmb();
+ writel(0xffffffff, acpu->comm + IPC_AUDIO_RPC_FLAG);
+ for (i = 0; i < 200; i++) {
+  if (READ_ONCE(acpu->failed)) { ret = -EIO; goto release; }
+  if (readl(acpu->sb2 + RPC_INT_EN) & RPC_INT_SA) {
+   dev_info(acpu->dev, "media firmware RPC interrupt enabled; verifying VO calls next\n");
+   ret = 0; goto release;
+  }
+  msleep(10);
+ }
+ WRITE_ONCE(acpu->failed, true);
+ ret = dev_err_probe(acpu->dev, -ETIMEDOUT, "Firmware RPC readiness timeout; require physical reset\n");
+release:
+ release_firmware(fw);
+ return ret;
 }
 
 static int acpu_probe(struct platform_device *pdev)
@@ -787,7 +931,9 @@
