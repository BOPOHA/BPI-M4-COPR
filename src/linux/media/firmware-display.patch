-	if (readl(acpu->sb2 + RPC_INT_EN) & RPC_INT_SA) {
+	if (start_rings) {
+		/* Validate/load/start only after IRQ registration. */
+	} else if (readl(acpu->sb2 + RPC_INT_EN) & RPC_INT_SA) {
 		dev_warn(dev, "audio firmware already running\n");
 		acpu_quiet(acpu);
 	} else if (be32_to_cpu(readl(acpu->comm)) != 0x16803001) {
@@ -806,6 +952,17 @@
 	if (ret)
 		return ret;
 
+
+	if (start_rings) {
+		ret = acpu_start_fresh(acpu);
+		if (ret) {
+			if (!acpu->fw_launch_attempted) return ret;
+			WRITE_ONCE(acpu->failed, true);
+			platform_set_drvdata(pdev, acpu);
+			dev_err(dev, "Firmware startup failed: resources retained, no VO; physical cold boot required\n");
+			return 0;
+		}
+	}
 
 	platform_set_drvdata(pdev, acpu);
 	ret = acpu_add_adev(acpu, RTD_ACPU_PCM_NAME, &acpu->pcm);
