+/* Fully initialized pinned RTD1395 BSP TV ABI, after RPC readiness. */
+static int vo_bpi_m4_tv_profile(struct rtd_vo *vo)
+{
+	u8 tv[VO_TV_SYSTEM_SIZE] = {};
+
+	if (!of_machine_is_compatible("bananapi,bpi-m4"))
+		return 0;
+	put_unaligned_be32(2, tv);       /* HDMI only. */
+	put_unaligned_be32(25, tv + 4);  /* 1080p60. */
+	tv[8] = 1; tv[9] = 1;
+	put_unaligned_be32(1, tv + 12);
+	put_unaligned_be32(4, tv + 16);
+	put_unaligned_be32(1, tv + 24);  /* HDMI on. */
+	put_unaligned_be32(3, tv + 28);  /* Vendor 48 kHz metadata. */
+	tv[32] = 1;
+	tv[34] = 0xa8;                  /* RGB, BT.709, 16:9. */
+	tv[36] = 16;                    /* VIC16. */
+	put_unaligned_be32(2, tv + 52);  /* SDR, no scrambling/deep colour. */
+	return vo_config_tv_system(vo, tv);
+}
+
+/* These buffers are never returned while firmware might still read them. */
+static int vo_scanout_alloc(struct rtd_vo *vo)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(vo->scanout); i++) {
+		vo->scanout[i].size = VO_SCANOUT_SIZE;
+		vo->scanout[i].phys = rtd_acpu_media_alloc(vo->acpu, VO_SCANOUT_SIZE);
