+/* Application GEM shmem is cached; firmware sees only owned WC scanout. */
+static void vo_opaque_line(u32 *line, unsigned int pixels)
+{
+	unsigned int x;
+
+	for (x = 0; x < pixels; x++)
+		line[x] |= 0xff000000;
+}
+
+static int vo_copy_opaque(void __iomem *dst,
+			  struct drm_shadow_plane_state *shadow,
+			  const struct drm_framebuffer *fb)
+{
+	const u8 *src;
+	u32 *line;
+	unsigned int y;
+
+	static_assert(VO_SCANOUT_PITCH % 64 == 0);
+	if (shadow->data[0].is_iomem)
+		return -EINVAL;
+	line = drm_format_conv_state_reserve(&shadow->fmtcnv_state,
+					     VO_SCANOUT_PITCH, GFP_KERNEL);
+	if (!line)
+		return -ENOMEM;
+	src = shadow->data[0].vaddr;
+	for (y = 0; y < VO_SCANOUT_HEIGHT; y++) {
+		memcpy(line, src, VO_SCANOUT_PITCH);
+		vo_opaque_line(line, VO_SCANOUT_PITCH / sizeof(*line));
+		/* ARM64 groups stores so write-combining can form full bursts. */
+		__iowrite64_copy(dst, line, VO_SCANOUT_PITCH / sizeof(u64));
+		src += fb->pitches[0];
+		dst += VO_SCANOUT_PITCH;
+	}
+	return 0;
+}
+
+/* Keep user XRGB data intact: the RTD1395 firmware reads pixel alpha. */
 static void vo_post(struct rtd_vo *vo, struct drm_plane_state *state)
 {
 	struct drm_framebuffer *fb = state->fb;
+	struct drm_shadow_plane_state *shadow = to_drm_shadow_plane_state(state);
+	struct vo_refclock __iomem *clk = vo->shared.vaddr + VO_REFCLOCK;
+	unsigned int slot = vo->scanout_next;
+	u32 displayed;
+	int ret;
 
 	if (!fb)
 		return;
-	vo_show(vo, drm_fb_dma_get_gem_addr(fb, state, 0), fb->width,
-		fb->height, fb->pitches[0]);
+	if (vo->scanout_used[slot]) {
+		/* Consumption alone does not mean an old buffer is off screen. */
+		ret = read_poll_timeout(readl, displayed,
+			be32_to_cpu(displayed) != U32_MAX &&
+			(s32)(be32_to_cpu(displayed) - vo->scanout_context[slot]) > 0,
+			1000, 100000, false, &clk->video_context);
+		if (ret) {
+			dev_warn_ratelimited(vo->dev,
+				"display context stalled; scanout reuse refused\n");
+			return;
+		}
+	}
+	ret = vo_copy_opaque(vo->scanout[slot].vaddr, shadow, fb);
+	if (ret) {
+		dev_warn_ratelimited(vo->dev, "opaque scanout copy failed; frame refused\n");
+		return;
+	}
+	wmb();
+	vo->scanout_context[slot] = vo->context;
+	vo_show(vo, vo->scanout[slot].phys, 1920, 1080, VO_SCANOUT_PITCH);
+	vo->scanout_used[slot] = true;
+	vo->scanout_next ^= 1;
 }
 
