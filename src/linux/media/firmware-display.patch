+/* Read-only presentation state: accepted DRM state alone is insufficient. */
+static ssize_t presentation_status_show(struct device *dev,
+                                       struct device_attribute *attr, char *buf)
+{
+    struct rtd_vo *vo = dev_get_drvdata(dev);
+    struct vo_ring_hdr __iomem *hdr = vo->shared.vaddr + VO_RING_HDR;
+
+    return sysfs_emit(buf,
+        "instance=%08x context=%u ring=%08x size=%u readers=%u read=%08x write=%08x displayed=%u scanout0=%08x scanout1=%08x\n",
+        vo->instance, READ_ONCE(vo->context),
+        be32_to_cpu(readl(&hdr->begin)), be32_to_cpu(readl(&hdr->size)),
+        be32_to_cpu(readl(&hdr->num_read)), be32_to_cpu(readl(&hdr->read[0])),
+        be32_to_cpu(readl(&hdr->write)),
+        be32_to_cpu(readl(vo->shared.vaddr + VO_REFCLOCK +
+                         offsetof(struct vo_refclock, video_context))),
+        (u32)vo->scanout[0].phys, (u32)vo->scanout[1].phys);
+}
